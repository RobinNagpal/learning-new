// Database naming: tables are plural snake_case, columns are snake_case
// (@@map / @map), so no identifier ever needs quoting in raw SQL. Prisma model
// and field names stay PascalCase/camelCase — the mapping is the only place the
// two conventions meet. See CLAUDE.md.
generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; the second target is the shared host's runtime
  // (Ubuntu 24.04, x86_64, OpenSSL 3.0) — deployment/scripts/build-server.sh
  // ships that engine next to the bundle.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id
  email        String        @unique
  // How this learner is addressed: the top folder of every audio object they
  // own, and what every public read is under. Allocated from the address at
  // registration (emailSlug + uniqueSlug in packages/schemas), never by the
  // learner and never changed — changing it orphans every recording — and
  // unique because two accounts at two providers can hold the same local part.
  // The default is the deploy gap described on Topic.slug: for the minutes
  // between the migration and the new bundle, the old code registers users
  // naming no username. Drop it in the next schema change.
  username     String        @unique @default(dbgenerated("md5((random())::text)"))
  // What `username` was called until it also became an address. Kept for one
  // deploy only: migrations run before the new bundle ships, so the code still
  // running when this lands selects this column and dropping it in the same
  // change would break every query touching a user. Nothing reads or writes it
  // now — registration deliberately leaves it to its default, since it carries
  // a unique index of its own.
  //
  // THE NEXT SCHEMA CHANGE DROPS IT, and repairs the deploy gap on the way:
  //   UPDATE users SET username = slug WHERE username <> slug;
  //   ALTER TABLE users DROP COLUMN slug;
  // An account registered in the minutes between the migration and the new
  // bundle has a real slug and a defaulted username, and that first line is
  // what gives it the name it should have had.
  slug         String        @unique @default(dbgenerated("md5((random())::text)"))
  // scrypt output, "scrypt$N$r$p$salt$hash". Excluded globally via the Prisma
  // client's `omit` config so it can never reach an API response.
  passwordHash String        @map("password_hash")
  // Sticky depth, 1-5. Follows the learner across topics rather than resetting.
  // DEFAULT_CARD_DEPTH in packages/schemas: the app falls back to the same
  // number when it names a card's depth before the card has arrived.
  defaultDepth Int           @default(2) @map("default_depth")
  // The profile. Every field is optional on purpose: a required form standing
  // between signing up and the first topic is the setup cost A14 bans. All
  // three are read by every generation call — see src/llm/prompts.ts.
  age          Int?
  // What they already know at a high level, in their own words.
  background   String        @default("")
  // LearningStyle values, as plain strings — the enum lives in packages/schemas.
  learningStyles String[]    @map("learning_styles")
  createdAt    DateTime      @default(now()) @map("created_at")
  sessions     AuthSession[]
  topics       Topic[]
  attempts     Attempt[]
  atoms        Atom[]
  studies      StudySession[]
  resumePoints ResumePoint[]
  mapPlans     MapPlan[]

  @@map("users")
}

/**
 * Bearer sessions. Without expiresAt a leaked token stayed valid forever and
 * the table grew by one row per login with nothing ever removing them.
 */
model AuthSession {
  token     String   @id
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Topic {
  id                  String         @id
  userId              String         @map("user_id")
  // Every URL for this topic is built from the slug, not the id. Unique per
  // user, which is as far as it has to go: nothing is shared between accounts.
  // The default exists only for the seconds between the migration running and
  // the new bundle shipping, where the old code inserts without one; drop it in
  // the next schema change. Random rather than '' because an empty slug would
  // fail the Slug schema on the very next read.
  slug                String         @default(dbgenerated("md5((random())::text)"))
  title               String
  // One line for the topics list. Seeded from the first line of the goal when
  // the topic is created, and edited on the topic's own edit screen after that.
  summary             String         @default("")
  goal                String         @default("")
  // TopicArchetype, stored as a plain string — the enum lives in
  // packages/schemas, so a new archetype needs no migration.
  archetype           String
  // Superseded by the map shape columns below. Kept, with a default, only so the
  // old bundle can still insert during the seconds between the migration and the
  // deploy; drop it in the next schema change.
  timeBudget          String         @default("week") @map("time_budget")
  // Where they are now and where they want to get to, in their own words.
  level               String         @default("")
  // How the map is shaped and sized. Levels says how many rows of headings sit
  // above the nodes; the heading counts say how many of each; minutes a day
  // times days says the size; depth says how far into the subject it goes. The
  // enums live in packages/schemas, so the columns are plain ints. The default
  // on levels is what every map built before it was a setting actually has.
  levels              Int            @default(2)
  mainHeadings        Int            @default(5) @map("main_headings")
  subHeadings         Int            @default(4) @map("sub_headings")
  minutesPerDay       Int            @default(20) @map("minutes_per_day")
  days                Int            @default(14)
  depth               Int            @default(2)
  // The instruction lines the map is built from. "" means the learner has not
  // edited them and the seed rendered from the columns above applies — storing a
  // copy of the seed would freeze it at the wording it had that day.
  mapInstructions     String         @default("") @map("map_instructions")
  // EnglishLevel, TechnicalDetail and ContentFormat, each a plain string — the
  // enums live in packages/schemas, so another value on any of them is a code
  // change with no migration behind it. The defaults are here for the seconds
  // between the migration running and the new bundle shipping, where the old
  // code still inserts a topic naming none of them.
  englishLevel        String         @default("medium") @map("english_level")
  technicalDetail     String         @default("medium") @map("technical_detail")
  format              String         @default("prose")
  // The one column these three replaced. Nothing reads it: it stays only
  // because the deploy runs migrations before the new bundle ships, and the old
  // code selects it for a few seconds after this lands. Drop it — column and
  // field together — in the next schema change. The default is what lets the
  // new code insert a topic without naming it.
  style               String         @default("short_and_crisp")
  // Standing instructions for everything generated in this topic. Empty means
  // the default in src/llm/prompts/content-instructions.md applies — storing a
  // copy of the default instead would freeze it at the value it had that day.
  contentInstructions String         @default("") @map("content_instructions")
  // ParagraphLength, as a plain string. Seeds the content instructions above.
  paragraphLength     String         @default("medium") @map("paragraph_length")
  // Minutes: what a node on this map is built to cost, and what a card is
  // written to. 1-5, the same band LearningNode.minutes is capped to.
  averageReadTime     Int            @default(3) @map("average_read_time")
  // NarrationVoice, as a plain string like every other enum here — one of
  // Google's prebuilt voice names, and the one this topic's cards are read in.
  // The default is both the product's default voice and what the old bundle
  // needs for the seconds between the migration running and the new code
  // shipping, where a topic is inserted naming no voice at all.
  narrationVoice      String         @default("Erinome") @map("narration_voice")
  status              String         @default("generating")
  error               String?
  createdAt           DateTime       @default(now()) @map("created_at")
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodes               LearningNode[]
  studies             StudySession[]
  resumePoints        ResumePoint[]
  mapPlans            MapPlan[]

  @@unique([userId, slug])
  @@index([userId])
  @@map("topics")
}

/**
 * The seven questions asked before a map is built, and the answers given to
 * them. One row per build attempt: the questions are generated fresh each time,
 * so a rebuild writes a new row rather than editing the old one, and the row a
 * map was built from stays exactly as the learner saw it.
 *
 * topicId is null between the questions being generated and the topic existing,
 * which is the whole of the create flow — the learner answers seven questions
 * about a topic that has not been created yet. It is filled in when the map is
 * built from this plan.
 *
 * Rows are also the budget counter for the questions call: it is a model call
 * reachable before any topic or node exists, so counting topics or nodes would
 * not bound it. See assertWithinBudget in src/topics.ts.
 */
model MapPlan {
  id        String   @id
  userId    String   @map("user_id")
  topicId   String?  @map("topic_id")
  // MapQuestionSet — validated by the schema in packages/schemas on every read,
  // because Json is the one column type Prisma cannot describe the shape of.
  questions Json
  // MapAnswers. Empty until the learner answers, and shorter than seven when
  // they skipped one.
  answers   Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic     Topic?   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([topicId])
  @@map("map_plans")
}

model LearningNode {
  id            String             @id
  topicId       String             @map("topic_id")
  // Null at the top of the map. A branch is grouping only: it has no card, no
  // drill and no minutes of its own, and nothing counts it as progress.
  parentId      String?            @map("parent_id")
  // Every ancestor slug joined by "/", which is what the URL carries. The unique
  // constraint is on this rather than on (parent_id, slug) because Postgres
  // never treats two NULLs as equal, so a constraint naming parent_id would
  // exempt every top-level node from itself. Siblings share a parent path, so
  // "path is unique in the topic" is the same statement, only enforceable.
  // The default is the deploy-gap placeholder described on Topic.slug.
  path          String             @default(dbgenerated("md5((random())::text)"))
  title         String
  claim         String
  // 0 on a branch. See packages/schemas LearningNode.minutes.
  minutes       Int
  archetype     String
  // Position among siblings, not within the topic: moving a node in the edit
  // screen swaps two rows at one level and leaves every other level alone.
  orderIndex    Int                @map("order_index")
  status        String             @default("untouched")
  capability    String
  // What the learner asked for this node's card in particular, added after the
  // topic's standing instructions whenever the card is written. "" means
  // nothing was asked. The default is also the deploy gap: the old bundle
  // inserts nodes that do not name it.
  cardInstructions String          @default("") @map("card_instructions")
  createdAt     DateTime           @default(now()) @map("created_at")
  topic         Topic              @relation(fields: [topicId], references: [id], onDelete: Cascade)
  parent        LearningNode?      @relation("NodeChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children      LearningNode[]     @relation("NodeChildren")
  cards         ConceptCard[]
  drills        Drill[]
  atoms         Atom[]
  questions     CardQuestion[]
  // Advisory edges only: the app shows them as a note and never gates on them.
  prerequisites NodePrerequisite[] @relation("NodeToPrerequisite")
  requiredBy    NodePrerequisite[] @relation("PrerequisiteToNode")

  @@unique([topicId, path])
  @@index([topicId, orderIndex])
  @@index([parentId])
  @@map("learning_nodes")
}

model NodePrerequisite {
  nodeId         String       @map("node_id")
  prerequisiteId String       @map("prerequisite_id")
  node           LearningNode @relation("NodeToPrerequisite", fields: [nodeId], references: [id], onDelete: Cascade)
  prerequisite   LearningNode @relation("PrerequisiteToNode", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([nodeId, prerequisiteId])
  @@index([prerequisiteId])
  @@map("node_prerequisites")
}

/**
 * Cards are cached per (node, depth, variant) and shared across learners, which
 * is what lets the controls under a card respond instantly. "variant" is built by
 * cardVariant in packages/schemas: the prompt revision, the angle, the minutes and
 * the register — everything that changes the writing without changing the depth.
 *
 * A row is never dropped because the settings moved. When nothing is cached at
 * the settings being asked for, the node answers with the newest card it has,
 * and the panel under it says what that card was written to; the learner
 * decides whether to write it again. That is why the variant has to be readable
 * back into settings (parseCardVariant), and why the instructions are stored
 * here in full — they are the one setting the key does not carry.
 */
model ConceptCard {
  id           String       @id
  nodeId       String       @map("node_id")
  depth        Int
  variant      String       @default("base")
  // The node's card_instructions at the moment this was written. Not in the
  // key: free text cannot be one without being hashed, and a hash cannot say
  // what it was. "" is also the deploy gap — the old bundle inserts without it.
  instructions String       @default("")
  content      Json
  createdAt    DateTime     @default(now()) @map("created_at")
  node         LearningNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  // At most one recording per card, and it goes when the card's node does.
  narration    CardNarration?

  @@unique([nodeId, depth, variant])
  @@map("concept_cards")
}

/**
 * One card read aloud: the spoken script, and where the audio object sits in
 * the audio bucket.
 *
 * Keyed on the card rather than the node, because a recording is of one
 * writing of one card — a node has a card per settings, and the learner may be
 * reading any of them. A rewrite replaces the card's content in place, and
 * cardWrittenAt below is what stops the old recording being served for it.
 *
 * The script is kept as well as the audio because it is the expensive half. It
 * is also the only readable record of what a recording says.
 *
 * Rows in the last hour are the budget counter for the call that makes them —
 * a model call plus a synthesis per press, and nothing else counts it. See
 * assertNarrationBudget in src/topics.ts.
 */
model CardNarration {
  id        String      @id
  cardId    String      @unique @map("card_id")
  script    String      @default("")
  // Built by narrationKey in packages/schemas from the learner's slug, the
  // topic's, the node's path and what the card was written to. Stored rather
  // than recomputed on read, so a row can be compared against the key it would
  // have now: they differ only when NARRATION_PROMPT_REVISION has moved, which
  // is what retires every recording in one line.
  objectKey String      @map("object_key")
  // The card's own createdAt at the moment this was recorded, which is what
  // says whether the recording is still of the words on the card. A rewrite
  // moves the card's date without changing its id, so a row whose value no
  // longer matches is a recording of text that has been replaced.
  //
  // The row is marked stale this way rather than deleted, because the rows in
  // the last hour are the budget counter: a counter another endpoint can empty
  // is one a learner can empty, and rewrite-then-play in a loop would then cost
  // nothing against the tightest ceiling in the product.
  cardWrittenAt DateTime @map("card_written_at")
  // NarrationStatus, as a plain string. A row exists from the moment the press
  // claims it, so most of the columns below are empty until the run finishes —
  // this is what says which. `createdAt` is when the run was claimed, so a row
  // still `pending` long past NARRATION_TIMEOUT_MS is a run whose process went
  // away, and is read as failed.
  status    String      @default("ready")
  // How many runs have been claimed on this row. Summed rather than counted by
  // assertNarrationBudget: one row per card means a card retried after every
  // failure would otherwise cost two model calls a press against a ceiling that
  // could never grow.
  attempts  Int         @default(1)
  // What to tell the learner when the status is failed. "" otherwise. Written
  // to be shown, the same way topics.error is.
  error     String      @default("")
  seconds   Int         @default(0)
  // Nothing reads this. It is here so the size of the bucket can be read off
  // the table rather than out of S3, which is the question asked when the bill
  // arrives.
  bytes     Int         @default(0)
  // The prebuilt voice that spoke it, so a row can still say which one after
  // NARRATION_VOICE has moved on.
  voice     String
  createdAt DateTime    @default(now()) @map("created_at")
  card      ConceptCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("card_narrations")
}

/**
 * A question the learner asked on a card, and the answer it got. Kept, so the
 * next open of the card shows what was asked on it rather than making the same
 * trip twice.
 *
 * Rows in the last hour are also the budget counter for the answering call —
 * it is a model call a learner can repeat without bound, and nothing else
 * counts it. See assertQuestionBudget in src/topics.ts.
 */
model CardQuestion {
  id        String       @id
  nodeId    String       @map("node_id")
  question  String
  answer    String
  createdAt DateTime     @default(now()) @map("created_at")
  node      LearningNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId, createdAt])
  @@map("card_questions")
}

model Drill {
  id              String       @id
  nodeId          String       @map("node_id")
  kind            String
  prompt          String
  completionTest  String       @map("completion_test")
  referencePoints String[]     @map("reference_points")
  hints           String[]
  createdAt       DateTime     @default(now()) @map("created_at")
  node            LearningNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  attempts        Attempt[]

  @@index([nodeId, kind])
  @@map("drills")
}

model Attempt {
  id        String   @id
  drillId   String   @map("drill_id")
  userId    String   @map("user_id")
  response  String
  verdict   Json
  hintsUsed Int      @default(0) @map("hints_used")
  createdAt DateTime @default(now()) @map("created_at")
  drill     Drill    @relation(fields: [drillId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("attempts")
}

model Atom {
  id           String       @id
  nodeId       String       @map("node_id")
  userId       String       @map("user_id")
  kind         String
  prompt       String
  answer       String
  intervalDays Int          @default(0) @map("interval_days")
  ease         Float        @default(2.5)
  lapses       Int          @default(0)
  dueAt        DateTime     @map("due_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  node         LearningNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueAt])
  @@map("atoms")
}

model StudySession {
  id             String    @id
  userId         String    @map("user_id")
  topicId        String    @map("topic_id")
  contract       String
  plannedMinutes Int       @map("planned_minutes")
  nodesCompleted Int       @default(0) @map("nodes_completed")
  startedAt      DateTime  @default(now()) @map("started_at")
  endedAt        DateTime? @map("ended_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic          Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@map("study_sessions")
}

/**
 * One restore point per (user, topic). Saved on every keystroke so leaving
 * mid-sentence costs nothing, and re-entry can show the half-written answer
 * rather than a summary of what is already done.
 */
model ResumePoint {
  userId      String   @map("user_id")
  topicId     String   @map("topic_id")
  nodeId      String   @map("node_id")
  drillId     String?  @map("drill_id")
  draft       String   @default("")
  lastThought String   @default("") @map("last_thought")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic       Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([userId, topicId])
  @@map("resume_points")
}
